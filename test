local AuroraState = { enabled = false, paletteName = "Default", opacity = 1, width = 900, diagWidth = 1200, speed = 1, curve = 1, segments = 50, part = nil }
local auroraTransform = { rotX = 0, rotY = 0, rotZ = 0, posX = 0, posY = 0, posZ = 0, tilt = 0 }
local function removeAurora() local p = workspace:FindFirstChild("Weak_Aurora_VFX") if p then p:Destroy() end AuroraState.part = nil end
local function buildTransparencySequence(opacity) local function clamp(v) return math.clamp(v, 0, 1) end local function scale(base) if base >= 1 then return 1 end if base <= 0 then return 0 end return clamp(1 - (1 - base) * opacity) end return NumberSequence.new({ NumberSequenceKeypoint.new(0, scale(1)), NumberSequenceKeypoint.new(0.1, scale(0.1)), NumberSequenceKeypoint.new(0.5, scale(0)), NumberSequenceKeypoint.new(0.9, scale(0.1)), NumberSequenceKeypoint.new(1, scale(1)) }) end
local function applyAuroraTransform()
    if not AuroraState.part or not AuroraState.part.Parent then return end
    local rx = math.rad(auroraTransform.rotX) local ry = math.rad(auroraTransform.rotY) local rz = math.rad(auroraTransform.rotZ) local tiltR = math.rad(auroraTransform.tilt)
    local basePos = Vector3.new(auroraTransform.posX, auroraTransform.posY, auroraTransform.posZ)
    AuroraState.part.CFrame = CFrame.new(basePos) * CFrame.Angles(rx, ry, rz) * CFrame.Angles(0, 0, tiltR)
end
local function injectAurora()
    removeAurora()
    local palette = AuroraPalettes[AuroraState.paletteName] or AuroraPalettes["Default"]
    local beamColorData = { ColorSequence.new({ ColorSequenceKeypoint.new(0, palette[1][1]), ColorSequenceKeypoint.new(0.5, palette[1][2]), ColorSequenceKeypoint.new(1, palette[1][3]) }), ColorSequence.new({ ColorSequenceKeypoint.new(0, palette[2][1]), ColorSequenceKeypoint.new(0.5, palette[2][2]), ColorSequenceKeypoint.new(1, palette[2][3]) }), ColorSequence.new({ ColorSequenceKeypoint.new(0, palette[3][1]), ColorSequenceKeypoint.new(0.5, palette[3][2]), ColorSequenceKeypoint.new(1, palette[3][3]) }) }
    local ns = buildTransparencySequence(AuroraState.opacity)
    local Part = Instance.new("Part") Part.Name = "Weak_Aurora_VFX" Part.Anchored = true Part.CanCollide = false Part.Transparency = 1 Part.Size = Vector3.new(1, 1, 1) Part.Position = Vector3.new(0, 0, 0) Part.Parent = workspace AuroraState.part = Part
    for index, v in ipairs({ { 600, 1800, 400, 0, 1, 0.05 }, { 560, 1600, -300, 100, 2, 0.07 }, { 520, 1500, 350, -150, 3, 0.04 }, { 480, 1700, -400, 200, 1, 0.09 }, { 440, 1400, 250, -100, 2, 0.06 }, { 400, 1600, -350, 50, 3, 0.08 }, { 360, 1300, 300, -200, 1, 0.05 }, { 320, 1500, -200, 150, 2, 0.07 } }) do
        pcall(function() local Beam = Instance.new("Beam") local A0 = Instance.new("Attachment", Part) local A1 = Instance.new("Attachment", Part) A0.WorldCFrame = CFrame.new(-v[2], v[1], v[4]) A1.WorldCFrame = CFrame.new(v[2], v[1], v[4]) Beam.Attachment0 = A0 Beam.Attachment1 = A1 Beam.Color = beamColorData[v[5]] Beam.Transparency = ns Beam.LightEmission = 1 Beam.LightInfluence = 0 Beam.FaceCamera = true Beam.CurveSize0 = v[3] * AuroraState.curve Beam.CurveSize1 = v[3] * 1.2 * AuroraState.curve Beam.Segments = AuroraState.segments Beam.Texture = "rbxassetid://10891817117" Beam.TextureLength = v[2] * 1.5 Beam.TextureMode = Enum.TextureMode.Wrap Beam.TextureSpeed = v[6] * AuroraState.speed Beam.Width0 = AuroraState.width Beam.Width1 = AuroraState.width Beam.ZOffset = -1 + index * 0.1 Beam.Parent = Part end)
    end
    for _, v in ipairs({ { 600, -900, -500, 300, 900, 500, 1, 0.06, 500 }, { 600, -900, 500, 300, 900, -500, 2, 0.05, -400 }, { 550, -1200, 0, 350, 1200, 0, 3, 0.08, 600 }, { 580, -900, -900, 380, 900, 900, 1, 0.07, -550 } }) do
        pcall(function() local Beam = Instance.new("Beam") local A0 = Instance.new("Attachment", Part) local A1 = Instance.new("Attachment", Part) A0.WorldCFrame = CFrame.new(v[2], v[1], v[3]) A1.WorldCFrame = CFrame.new(v[5], v[4], v[6]) Beam.Attachment0 = A0 Beam.Attachment1 = A1 Beam.Color = beamColorData[v[7]] Beam.Transparency = ns Beam.LightEmission = 1 Beam.LightInfluence = 0 Beam.FaceCamera = true Beam.CurveSize0 = v[9] * AuroraState.curve Beam.CurveSize1 = v[9] * 0.8 * AuroraState.curve Beam.Segments = AuroraState.segments Beam.Texture = "rbxassetid://10891817117" Beam.TextureLength = 2000 Beam.TextureMode = Enum.TextureMode.Wrap Beam.TextureSpeed = v[8] * AuroraState.speed Beam.Width0 = AuroraState.diagWidth Beam.Width1 = AuroraState.diagWidth Beam.ZOffset = 0 Beam.Parent = Part end)
    end
    applyAuroraTransform()
end
