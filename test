-- Queue buat applySmartAsset biar nggak spam GetObjects (OPTIMASI)
local smartAssetQueue = {}
local smartAssetBusy = false

local function processSmartAssetQueue()
    if smartAssetBusy then return end
    smartAssetBusy = true
    task.spawn(function()
        while #smartAssetQueue > 0 do
            local job = table.remove(smartAssetQueue, 1)
            if job and job.target and job.target.Parent then
                pcall(function()
                    local old = job.target:FindFirstChild(job.uniqueName)
                    if old then old:Destroy() end
                    if job.state then
                        local successObj, assets = pcall(function()
                            return game:GetObjects("rbxassetid://" .. job.assetId)
                        end)
                        if successObj and assets and assets[1] then
                            local asset = assets[1]
                            asset.Name = job.uniqueName
                            local handle = asset:IsA("Accessory") and asset:FindFirstChild("Handle") or (asset:IsA("BasePart") and asset or asset:FindFirstChildWhichIsA("BasePart", true))
                            if handle then
                                handle.CanCollide = false
                                handle.Massless = true
                                local accessoryAttachment = handle:FindFirstChildWhichIsA("Attachment")
                                local targetPart, matchingAttachment
                                if accessoryAttachment then
                                    local attName = accessoryAttachment.Name
                                    for _, desc in ipairs(job.target:GetDescendants()) do
                                        if desc:IsA("Attachment") and desc.Name == attName then
                                            matchingAttachment = desc
                                            targetPart = desc.Parent
                                            break
                                        end
                                    end
                                end
                                if not targetPart or not matchingAttachment then
                                    targetPart = job.target:FindFirstChild("Head") or job.target:FindFirstChild("head")
                                    if targetPart then
                                        asset.Parent = job.target
                                        if handle:IsA("BasePart") and targetPart:IsA("BasePart") then
                                            pcall(function() handle.CFrame = targetPart.CFrame * CFrame.new(0, 0.5, 0) end)
                                            if not handle:FindFirstChild("NearWeld") then
                                                local weld = Instance.new("WeldConstraint")
                                                weld.Name = "NearWeld"
                                                weld.Part0 = targetPart
                                                weld.Part1 = handle
                                                weld.Parent = handle
                                            end
                                        end
                                    end
                                else
                                    asset.Parent = job.target
                                    if handle:IsA("BasePart") and targetPart:IsA("BasePart") then
                                        pcall(function() handle.CFrame = matchingAttachment.WorldCFrame * accessoryAttachment.CFrame:Inverse() end)
                                        if not handle:FindFirstChild("NearWeld") then
                                            local att0 = Instance.new("Attachment")
                                            att0.CFrame = accessoryAttachment.CFrame
                                            att0.Parent = handle
                                            local att1 = Instance.new("Attachment")
                                            att1.CFrame = matchingAttachment.CFrame
                                            att1.Parent = targetPart
                                            local rigid = Instance.new("RigidConstraint")
                                            rigid.Name = "NearWeld"
                                            rigid.Attachment0 = att0
                                            rigid.Attachment1 = att1
                                            rigid.Parent = handle
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            task.wait(0.15)
        end
        smartAssetBusy = false
    end)
end

local function applySmartAsset(target, assetId, uniqueName, state)
    if not target then return end
    if not state then
        local old = target:FindFirstChild(uniqueName)
        if old then old:Destroy() end
        return
    end
    table.insert(smartAssetQueue, { target = target, assetId = assetId, uniqueName = uniqueName, state = state })
    processSmartAssetQueue()
end

