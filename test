local currentEmotes, selectEmotes = {}, {}
for i = 1, 12 do currentEmotes[i] = "" selectEmotes[i] = "" end

local emoteReplacements, activeClones = {}, {}
local emoteAttributeBackup = {}
local emoteCache = {}
local emoteCacheBuilt = false
local wheelConns, globalGuiConn = {}, nil
local hookActive, lastEmoteName = nil, nil
local nameReplacements = {}
local EmoteClassRef, emoteActivateW, emoteDeactivateW, origAct, origDeact
local replacementTargetIds = {}
local emoteWarmupUntil = 0

local function buildEmoteCache()
    table.clear(emoteCache)
    local items = ReplicatedStorage:FindFirstChild("Items")
    if not items then emoteCacheBuilt = false return end
    for _, obj in ipairs(items:GetDescendants()) do
        if (obj:IsA("ModuleScript") or obj:IsA("Folder")) and obj.Parent and obj.Parent.Name == "Emotes" then
            local id = obj:GetAttribute("ID")
            if id then
                local info = { Name = obj.Name, ID = id, Instance = obj }
                emoteCache[obj.Name:lower()] = info
                emoteCache[tostring(id)] = info
            end
        end
    end
    emoteCacheBuilt = true
end

local function getEmoteDisplayName(info)
    if not info then return nil end
    if info.DisplayName then return info.DisplayName end
    if not info.Instance then return info.Name end
    local ok, cfg = pcall(require, info.Instance)
    local name = nil
    if ok and type(cfg) == "table" and type(cfg.AppearanceInfo) == "table" then
        name = cfg.AppearanceInfo.Name
    end
    if type(name) ~= "string" or name == "" then name = info.Name end
    info.DisplayName = name
    return name
end

local function getEmoteInfo(input)
    if not input or input == "" then return nil end
    if not emoteCacheBuilt then buildEmoteCache() end
    local k = tostring(input):lower()
    local r = emoteCache[k]
    if r then return r end
    local id = tonumber(input)
    if id then return { Name = tostring(id), ID = id } end
    return nil
end

local function backupObj(inst)
    if activeClones[inst] then return end
    local bk = {}
    for _, c in ipairs(inst:GetChildren()) do
        local ok, cl = pcall(function() return c:Clone() end)
        if ok and cl then bk[#bk + 1] = cl end
    end
    activeClones[inst] = bk
end

local function clearChildren(inst)
    local c = inst:GetChildren()
    for i = 1, #c do pcall(function() c[i]:Destroy() end) end
end

local function restoreObj(inst, bk)
    if not inst or not inst.Parent then return end
    clearChildren(inst)
    for i = 1, #bk do pcall(function() bk[i]:Clone().Parent = inst end) end
end

local function applyEmoteAsset(ci, ti)
    if not ci.Instance or not ti.Instance then return false end
    backupObj(ci.Instance)
    if not emoteAttributeBackup[ci.Instance] then
        local at = {}
        for k, v in pairs(ci.Instance:GetAttributes()) do at[k] = v end
        emoteAttributeBackup[ci.Instance] = at
    end
    clearChildren(ci.Instance)
    for _, c in ipairs(ti.Instance:GetChildren()) do
        pcall(function() c:Clone().Parent = ci.Instance end)
    end
    pcall(function()
        for k, v in pairs(ti.Instance:GetAttributes()) do
            if k ~= "ID" and k ~= "Name" then ci.Instance:SetAttribute(k, v) end
        end
    end)
    return true
end
local function resetEmoteAssets()
    for inst, bk in pairs(activeClones) do restoreObj(inst, bk) end
    for inst, at in pairs(emoteAttributeBackup) do
        pcall(function()
            for k in pairs(inst:GetAttributes()) do inst:SetAttribute(k, nil) end
            for k, v in pairs(at) do inst:SetAttribute(k, v) end
        end)
    end
    table.clear(activeClones)
    table.clear(emoteAttributeBackup)
end

local function disconnectWheel()
    for i = 1, #wheelConns do pcall(function() wheelConns[i]:Disconnect() end) end
    table.clear(wheelConns)
    if globalGuiConn then pcall(function() globalGuiConn:Disconnect() end) globalGuiConn = nil end
end

local function isWheelLabel(tl)
    local p = tl.Parent
    local depth = 0
    while p and depth < 5 do
        local n = p.Name:lower()
        if n:find("wheel") or n:find("radial") or n:find("emotemenu") then return true end
        if n:find("inventory") or n:find("shop") or n:find("backpack") then return false end
        p = p.Parent
        depth = depth + 1
    end
    return false
end

local function handleTextLabel(tl)
    if not tl or not tl:IsA("TextLabel") then return end
    local function apply()
        local t = tl.Text
        local r = nameReplacements[t]
        if r and t ~= r then tl.Text = r end
    end
    apply()
    table.insert(wheelConns, tl:GetPropertyChangedSignal("Text"):Connect(apply))
end

local function startWheelWatcher()
    disconnectWheel()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and isWheelLabel(d) then handleTextLabel(d) end
    end
    globalGuiConn = pg.DescendantAdded:Connect(function(d)
        if d:IsA("TextLabel") then
            task.defer(function()
                if d and d.Parent and isWheelLabel(d) then handleTextLabel(d) end
            end)
        end
    end)
end

