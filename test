-- 14. COSMETIC UNUSUAL CHANGER
-- ==========================================
local currentUnusual, selectUnusual = "", ""
local cosmeticItemCache = {}
local cosmeticCacheBuilt = false

local function validItemObject(obj)
    local c = obj.ClassName
    return c == "Folder" or c == "Model" or c == "ModuleScript" or c == "Configuration"
end

local function buildCosmeticCache()
    table.clear(cosmeticItemCache)
    local items = ReplicatedStorage:FindFirstChild("Items")
    if not items then cosmeticCacheBuilt = false return end
    for _, obj in ipairs(items:GetDescendants()) do
        if validItemObject(obj) then cosmeticItemCache[obj.Name:lower()] = obj end
    end
    cosmeticCacheBuilt = true
end

local function getCosmeticItem(name)
    if not name or name == "" then return nil end
    if not cosmeticCacheBuilt then buildCosmeticCache() end
    return cosmeticItemCache[name:lower()]
end

local function applyUnusualAsset(cn, tn)
    if cn == "" or tn == "" then return false end
    local cur = getCosmeticItem(cn)
    local tar = getCosmeticItem(tn)
    if not cur or not tar then return false end
    backupObj(cur)
    clearChildren(cur)
    for _, c in ipairs(tar:GetChildren()) do
        pcall(function() c:Clone().Parent = cur end)
    end
    return true
end
local function executeApply()
    table.clear(emoteReplacements)
    table.clear(replacementTargetIds)
    table.clear(nameReplacements)
    if not emoteCacheBuilt then buildEmoteCache() end
    if not cosmeticCacheBuilt then buildCosmeticCache() end

    local cnt = 0
    for i = 1, 12 do
        local ci, ti = currentEmotes[i], selectEmotes[i]
        if ci ~= "" and ti ~= "" then
            ci, ti = ci:gsub("%s+", ""), ti:gsub("%s+", "")
            local cInfo, tInfo = getEmoteInfo(ci), getEmoteInfo(ti)
            if cInfo and tInfo then
                emoteReplacements[cInfo.Name] = { select = tInfo.Name, selectID = tInfo.ID }
                replacementTargetIds[tInfo.ID] = true
                local td = getEmoteDisplayName(tInfo) or tInfo.Name
                local cd = getEmoteDisplayName(cInfo) or cInfo.Name
                nameReplacements[cInfo.Name] = td
                if cd ~= td then nameReplacements[cd] = td end
                if cInfo.Instance and tInfo.Instance then
                    if applyEmoteAsset(cInfo, tInfo) then cnt = cnt + 1 end
                end
            end
        end
    end

    if currentUnusual ~= "" and selectUnusual ~= "" then
        if applyUnusualAsset(currentUnusual, selectUnusual) then cnt = cnt + 1 end
    end

    stopEmoteHook()
    startEmoteHook()
    startWheelWatcher()
    return true, cnt
end

local function resetAll()
    stopEmoteHook()
    disconnectWheel()
    resetEmoteAssets()
    table.clear(emoteReplacements)
    table.clear(replacementTargetIds)
    table.clear(nameReplacements)
end

