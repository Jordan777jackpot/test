local shaderState = { rainConn = nil, rainSound = nil, rainFolder = nil }

local function clearSky()
    for _, sky in ipairs(LightingSvc:GetChildren()) do
        if sky:IsA("Sky") then sky:Destroy() end
    end
    if shaderState.rainSound then pcall(function() shaderState.rainSound:Stop() end) shaderState.rainSound = nil end
    if shaderState.rainConn then pcall(function() shaderState.rainConn:Disconnect() end) shaderState.rainConn = nil end
    if shaderState.rainFolder and shaderState.rainFolder.Parent then pcall(function() shaderState.rainFolder:Destroy() end) end
    shaderState.rainFolder = nil
end

local function resetLighting()
    pcall(function()
        LightingSvc.ClockTime = 14
        LightingSvc.Brightness = 2
        LightingSvc.Ambient = Color3.fromRGB(70, 70, 70)
        LightingSvc.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        LightingSvc.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
        LightingSvc.FogColor = Color3.fromRGB(191, 191, 191)
        LightingSvc.FogEnd = 100000
        LightingSvc.ShadowSoftness = 0.2
        LightingSvc.ExposureCompensation = 0
    end)
end

local function simpleClearEffects()
    for _, child in ipairs(LightingSvc:GetChildren()) do
        if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("ColorCorrectionEffect")
            or child:IsA("BloomEffect") or child:IsA("BlurEffect") or child:IsA("SunRaysEffect") then
            pcall(function() child:Destroy() end)
        end
    end
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        for _, child in ipairs(terrain:GetChildren()) do
            if child:IsA("Clouds") then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

local function simpleSetHidden(obj, prop, value)
    pcall(function() sethiddenproperty(obj, prop, value) end)
end

local function applySkyboxData(name, data)
    if not data then return end
    clearSky()
    resetLighting()
    local sky = Instance.new("Sky")
    sky.SkyboxBk = data.Bk
    sky.SkyboxDn = data.Dn
    sky.SkyboxFt = data.Ft
    sky.SkyboxLf = data.Lf
    sky.SkyboxRt = data.Rt
    sky.SkyboxUp = data.Up
    sky.Name = name .. "Skybox"
    sky.Parent = LightingSvc
    pcall(function() WindUI:Notify({ Title = "Shader", Content = "Skybox: " .. name, Duration = 3 }) end)
end

local function applySkyboxAsset(id)
    clearSky()
    local ok, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))[1]
    end)
    if not (ok and result) then
        pcall(function() WindUI:Notify({ Title = "Skybox", Content = "Gagal load asset ID " .. tostring(id), Duration = 3 }) end)
        return false
    end
    if result:IsA("Sky") then result.Parent = LightingSvc return true end
    local sky = result:FindFirstChildOfClass("Sky")
    if sky then sky.Parent = LightingSvc return true end
    result.Parent = LightingSvc
    return true
end

