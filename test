do
    local atmoState = { obj = nil, original = nil, isNew = false }
    local ATMO_PROPS = {"Density", "Offset", "Color", "Decay", "Glare", "Haze"}
    local function getAtmosphere() if atmoState.obj and atmoState.obj.Parent then return atmoState.obj end local existing = LightingSvc:FindFirstChildOfClass("Atmosphere") if existing then atmoState.isNew = false atmoState.original = {} for _, p in ipairs(ATMO_PROPS) do atmoState.original[p] = existing[p] end atmoState.obj = existing else atmoState.isNew = true atmoState.original = nil local atm = Instance.new("Atmosphere") atm.Name = "Extra_Atmosphere" atm.Density = 0 atm.Offset = 0 atm.Glare = 0 atm.Haze = 0 atm.Parent = LightingSvc atmoState.obj = atm end return atmoState.obj end
    function GrafikExtra.SetFogDensity(v) v = tonumber(v) or 0 if v <= 0 then local atm = getAtmosphere() if atm then atm.Density = 0 end pcall(function() LightingSvc.FogEnd = 100000 end) else local atm = getAtmosphere() if atm then atm.Density = v / 1000 * 0.5 end pcall(function() LightingSvc.FogEnd = math.max(10, 2000 - v * 1.95) end) end end
    local cloudState = { obj = nil, original = nil, isNew = false }
    function GrafikExtra.SetClouds(v) v = math.clamp(tonumber(v) or 0, 0, 100) local terrain = Workspace:FindFirstChild("Terrain") if not terrain then return end if v <= 0 then if cloudState.obj then if cloudState.isNew then pcall(function() cloudState.obj:Destroy() end) elseif cloudState.original then pcall(function() cloudState.obj.Cover = cloudState.original.Cover cloudState.obj.Density = cloudState.original.Density cloudState.obj.Color = cloudState.original.Color end) end cloudState.obj = nil cloudState.original = nil cloudState.isNew = false end return end if not cloudState.obj or not cloudState.obj.Parent then local existing = terrain:FindFirstChildOfClass("Clouds") if existing then cloudState.isNew = false cloudState.original = { Cover = existing.Cover, Density = existing.Density, Color = existing.Color } cloudState.obj = existing else cloudState.isNew = true cloudState.original = nil local c = Instance.new("Clouds") pcall(function() c.Parent = terrain end) cloudState.obj = c end end pcall(function() cloudState.obj.Cover = math.clamp(v / 100 * 0.85, 0, 1) cloudState.obj.Density = math.clamp(v / 100 * 1.5, 0, 1) cloudState.obj.Color = Color3.fromRGB(255, 255, 255) end) end
    local snowState = { part = nil, conn = nil, savedMaterials = nil }
    function GrafikExtra.SetWinterSnow(on) local terrain = Workspace:FindFirstChild("Terrain") if on then if not snowState.savedMaterials and terrain then snowState.savedMaterials = { Snow = terrain:GetMaterialColor(Enum.Material.Snow), Grass = terrain:GetMaterialColor(Enum.Material.Grass), Ice = terrain:GetMaterialColor(Enum.Material.Ice), LeafyGrass = terrain:GetMaterialColor(Enum.Material.LeafyGrass) } pcall(function() terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(235, 253, 255)) terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(235, 253, 255)) terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(235, 253, 255)) terrain:SetMaterialColor(Enum.Material.Ice, Color3.fromRGB(228, 234, 249)) end) end if not snowState.part then local p = Instance.new("Part") p.Name = "Extra_WorldSnow" p.Transparency = 1 p.Anchored = true p.CanCollide = false p.Size = Vector3.new(300, 1, 300) local pe = Instance.new("ParticleEmitter") pe.Name = "SnowEmitter" pe.Texture = "rbxassetid://137831468" pe.Color = ColorSequence.new(Color3.new(1, 1, 1)) pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.2) }) pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0.9) }) pe.Speed = NumberRange.new(6, 12) pe.Lifetime = NumberRange.new(15, 25) pe.Rate = 600 pe.EmissionDirection = Enum.NormalId.Bottom pe.Parent = p snowState.part = p end snowState.part.Parent = Workspace.CurrentCamera if not snowState.conn then snowState.conn = RunService.RenderStepped:Connect(function() if Workspace.CurrentCamera and snowState.part and snowState.part.Parent then local pos = Workspace.CurrentCamera.CFrame.Position snowState.part.CFrame = CFrame.new(pos.X, pos.Y + 60, pos.Z) end end) end else if snowState.conn then snowState.conn:Disconnect() snowState.conn = nil end if snowState.part then pcall(function() snowState.part:Destroy() end) snowState.part = nil end if snowState.savedMaterials and terrain then pcall(function() terrain:SetMaterialColor(Enum.Material.Snow, snowState.savedMaterials.Snow) terrain:SetMaterialColor(Enum.Material.Grass, snowState.savedMaterials.Grass) terrain:SetMaterialColor(Enum.Material.Ice, snowState.savedMaterials.Ice) terrain:SetMaterialColor(Enum.Material.LeafyGrass, snowState.savedMaterials.LeafyGrass) end) snowState.savedMaterials = nil end end end
    local lightingOriginal = nil
    local function snapshotLighting() if lightingOriginal then return end lightingOriginal = { Brightness = LightingSvc.Brightness, ClockTime = LightingSvc.ClockTime, ExposureCompensation = LightingSvc.ExposureCompensation, ShadowSoftness = LightingSvc.ShadowSoftness, EnvironmentSpecularScale = LightingSvc.EnvironmentSpecularScale, EnvironmentDiffuseScale = LightingSvc.EnvironmentDiffuseScale, GlobalShadows = LightingSvc.GlobalShadows } end
    function GrafikExtra.SetBrightness(v) snapshotLighting() pcall(function() LightingSvc.Brightness = tonumber(v) or 2 end) end
    function GrafikExtra.SetClockTime(v) snapshotLighting() pcall(function() LightingSvc.ClockTime = tonumber(v) or 14 end) end
    function GrafikExtra.SetExposure(v) snapshotLighting() pcall(function() LightingSvc.ExposureCompensation = tonumber(v) or 0 end) end
    function GrafikExtra.SetShadowSoftness(v) snapshotLighting() pcall(function() LightingSvc.ShadowSoftness = math.clamp(tonumber(v) or 0.2, 0, 1) end) end
    function GrafikExtra.SetSpecularScale(v) snapshotLighting() pcall(function() LightingSvc.EnvironmentSpecularScale = math.clamp(tonumber(v) or 1, 0, 1) end) end
    function GrafikExtra.SetDiffuseScale(v) snapshotLighting() pcall(function() LightingSvc.EnvironmentDiffuseScale = math.clamp(tonumber(v) or 1, 0, 1) end) end
    function GrafikExtra.SetGlobalShadows(on) snapshotLighting() pcall(function() LightingSvc.GlobalShadows = on == true end) end
    function GrafikExtra.ResetLighting() if not lightingOriginal then return end pcall(function() LightingSvc.Brightness = lightingOriginal.Brightness LightingSvc.ClockTime = lightingOriginal.ClockTime LightingSvc.ExposureCompensation = lightingOriginal.ExposureCompensation LightingSvc.ShadowSoftness = lightingOriginal.ShadowSoftness LightingSvc.EnvironmentSpecularScale = lightingOriginal.EnvironmentSpecularScale LightingSvc.EnvironmentDiffuseScale = lightingOriginal.EnvironmentDiffuseScale LightingSvc.GlobalShadows = lightingOriginal.GlobalShadows end) lightingOriginal = nil end
    getgenv().GrafikExtra = GrafikExtra
end

