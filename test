local SSRTab = Window:Tab({ Title = "<font color='#ff0000'>SSR</font>", Icon = "layers" })
pcall(function() SSRTab:Section({ Title = "<font color='#ff0000'>Screen Space Reflections</font>", TextSize = 16 }) end)

local SSRState = { enabled = false, transparency = 4, thickness = 0.06, detail = 5, descendantConn = nil, clones = {} }
local function getOrCreateSSRModel() local m = workspace:FindFirstChild("SSR_Global_Model") if not m then m = Instance.new("Model") m.Name = "SSR_Global_Model" m.Parent = workspace local h = Instance.new("Highlight") h.Name = "SSR_Highlight" h.FillTransparency = 1 h.OutlineTransparency = 1 h.Parent = m end return m end
local function isCharacterPart(part) local p = part.Parent while p and p ~= workspace do if p:IsA("Model") then local h = p:FindFirstChildOfClass("Humanoid") if not h then h = Players:GetPlayerFromCharacter(p) if not h then h = Players:FindFirstChild(p.Name) end end if h then return true end end p = p.Parent end return false end
local function injectSSRClone(instance)
    if not instance:IsA("BasePart") then return end if instance.Transparency >= 1 then return end if instance.Name == "RoShade_Glass" or instance.Name == "SSR_Reflective_Layer" or instance.Name == "Preset_Overlay" then return end if SSRState.clones[instance] then return end if instance.Name == "Terrain" then return end if isCharacterPart(instance) then return end if not instance.Anchored then return end
    pcall(function()
        local isComplex = instance:IsA("WedgePart") or instance:IsA("CornerWedgePart") or instance:IsA("MeshPart") or instance:IsA("UnionOperation") or (instance:IsA("Part") and instance.Shape ~= Enum.PartType.Block)
        local arch = instance.Archivable instance.Archivable = true local clone = instance:Clone() instance.Archivable = arch
        for _, item in ipairs(clone:GetChildren()) do if item:IsA("DataModelMesh") then pcall(function() item.TextureId = "" end) else item:Destroy() end end
        clone.Name = "SSR_Reflective_Layer" clone.Material = Enum.Material.Glass clone.Transparency = SSRState.transparency / 10 clone.CanCollide = false clone.CanTouch = false clone.CanQuery = false clone.CastShadow = false clone.Massless = true if clone:IsA("MeshPart") then clone.TextureID = "" end
        local size = instance.Size local tn = SSRState.thickness
        if isComplex then clone.Size = Vector3.new(math.max(size.X + 0.02, 0.1), math.max(size.Y + 0.02, 0.1), math.max(size.Z + 0.02, 0.1)) clone.CFrame = instance.CFrame + Vector3.new(0, 0.045, 0) else clone.Size = Vector3.new(math.max(size.X + tn, 0.1), math.max(size.Y + tn, 0.1), math.max(size.Z + tn, 0.1)) clone.CFrame = instance.CFrame end
        local weld = Instance.new("WeldConstraint") weld.Part0 = instance weld.Part1 = clone weld.Parent = clone clone.Parent = getOrCreateSSRModel() SSRState.clones[instance] = clone
    end)
end
local function updateSSRTransparency(percent) SSRState.transparency = 10 * (1 - percent / 100) for orig, clone in pairs(SSRState.clones) do if orig and orig.Parent and clone and clone.Parent then pcall(function() clone.Transparency = SSRState.transparency end) end end end
local function updateSSRThickness(thickness) SSRState.thickness = thickness for orig, clone in pairs(SSRState.clones) do if orig and orig.Parent and clone and clone.Parent then pcall(function() local size = orig.Size clone.Size = Vector3.new(math.max(size.X + thickness, 0.1), math.max(size.Y + thickness, 0.1), math.max(size.Z + thickness, 0.1)) clone.CFrame = orig.CFrame end) end end end
local function clearSSR() if SSRState.descendantConn then SSRState.descendantConn:Disconnect() SSRState.descendantConn = nil end local m = workspace:FindFirstChild("SSR_Global_Model") if m then m:Destroy() end SSRState.clones = {} end
local function enableSSR()
    SSRState.enabled = true
    pcall(function() LightingSvc.EnvironmentSpecularScale = 1 LightingSvc.EnvironmentDiffuseScale = 1 end)
    task.spawn(function() local desc = workspace:GetDescendants() local clock = os.clock() for i, item in ipairs(desc) do if not SSRState.enabled then return end injectSSRClone(item) if i % 1500 == 0 or os.clock() - clock > 0.015 then task.wait() clock = os.clock() end end end)
    if not SSRState.descendantConn then SSRState.descendantConn = workspace.DescendantAdded:Connect(function(d) if not SSRState.enabled then return end task.wait(0.5) pcall(function() injectSSRClone(d) end) end) end
end
local function disableSSR() SSRState.enabled = false clearSSR() end

SSRTab:Toggle({ Title = "<font color='#ff0000'>Enable Global SSR</font>", Value = false, Callback = function(s) if s then enableSSR() else disableSSR() end end })
SSRTab:Slider({ Title = "<font color='#ff0000'>SSR Opacity</font>", Step = 1, Value = { Min = 0, Max = 100, Default = 60 }, Callback = function(percent) updateSSRTransparency(percent) end })
SSRTab:Slider({ Title = "<font color='#ff0000'>SSR Thickness</font>", Step = 0.001, Value = { Min = -2, Max = 4, Default = 0.06 }, Callback = function(v) updateSSRThickness(v) end })
SSRTab:Slider({ Title = "<font color='#ff0000'>Reflection Detail</font>", Step = 1, Value = { Min = 1, Max = 10, Default = 5 }, Callback = function(v) SSRState.detail = v end })
SSRTab:Button({ Title = "<font color='#ff0000'>Refresh SSR</font>", Callback = function() if SSRState.enabled then disableSSR() task.wait(0.2) enableSSR() end end })
SSRTab:Button({ Title = "<font color='#ff0000'>Clear SSR</font>", Callback = function() disableSSR() end })

-- GLOSSY
local GlossyState = { enabled = { Combo = false, Metal = false, Plastic = false }, intensity = 0.25, overlays = { Combo = {}, Metal = {}, Plastic = {} }, conns = { Combo = nil, Metal = nil, Plastic = nil }, originalSpecular = nil, originalDiffuse = nil, skipNames = {"tree", "leaf", "leaves", "grass", "bush", "plant", "spawn", "stair", "step"}, presets = { Combo = { Material = Enum.Material.Glass, Reflectance = 0.8, Name = "Glossy_Overlay_Combo" }, Metal = { Material = Enum.Material.Metal, Reflectance = 1, Name = "Glossy_Overlay_Metal" }, Plastic = { Material = Enum.Material.SmoothPlastic, Reflectance = 1, Name = "Glossy_Overlay_Plastic" } } }
local function isCharacterPartGlossy(part) local p = part.Parent while p and p ~= workspace do if p:IsA("Model") then local h = p:FindFirstChildOfClass("Humanoid") if h then return true end local plr = Players:GetPlayerFromCharacter(p) if plr then return true end end p = p.Parent end return false end
local function shouldSkipPart(part) if not part:IsA("BasePart") then return true end if part.Name == "Terrain" then return true end if part.Name == "WetOverlay" or part.Name == "WetLook_Puddle" or part.Name == "SSR_Reflective_Layer" or part.Name == "RoShade_Glass" then return true end if string.find(part.Name, "Glossy_Overlay", 1, true) then return true end if part.Transparency >= 0.95 then return true end if not part.Anchored then return true end if part.Material == Enum.Material.Grass or part.Material == Enum.Material.LeafyGrass or part.Material == Enum.Material.Fabric then return true end if part.Parent and part.Parent.Parent and part.Parent.Parent:IsA("Model") then if part.Parent.Parent:FindFirstChildOfClass("Humanoid") then return true end end if isCharacterPartGlossy(part) then return true end local lower = part.Name:lower() for _, skip in ipairs(GlossyState.skipNames) do if lower:match(skip) then return true end end return false end
local function createGlossyOverlay(part, mode) if shouldSkipPart(part) then return end if GlossyState.overlays[mode][part] then return end local preset = GlossyState.presets[mode] if not preset then return end pcall(function() local arch = part.Archivable part.Archivable = true local clone = part:Clone() part.Archivable = arch for _, item in ipairs(clone:GetChildren()) do if item:IsA("DataModelMesh") then pcall(function() item.TextureId = "" end) else item:Destroy() end end clone.Name = preset.Name clone.Material = preset.Material clone.Transparency = GlossyState.intensity clone.Reflectance = preset.Reflectance clone.Color = Color3.fromRGB(15, 15, 15) clone.CanCollide = false clone.CanTouch = false clone.CanQuery = false clone.CastShadow = false clone.Massless = true if clone:IsA("MeshPart") then clone.TextureID = "" end if clone:IsA("BasePart") and not clone:IsA("MeshPart") then local size = clone.Size clone.Size = Vector3.new(math.max(size.X + 0.02, 0.1), math.max(size.Y + 0.02, 0.1), math.max(size.Z + 0.02, 0.1)) clone.CFrame = clone.CFrame + Vector3.new(0, 0.045, 0) end local weld = Instance.new("WeldConstraint") weld.Part0 = part weld.Part1 = clone weld.Parent = clone clone.Parent = getOrCreateSSRModel() GlossyState.overlays[mode][part] = clone end) end
local function setGlossyMode(mode, on) if GlossyState.enabled[mode] == on then return end GlossyState.enabled[mode] = on if on then if not GlossyState.originalSpecular then GlossyState.originalSpecular = LightingSvc.EnvironmentSpecularScale GlossyState.originalDiffuse = LightingSvc.EnvironmentDiffuseScale end pcall(function() LightingSvc.EnvironmentSpecularScale = 1 LightingSvc.EnvironmentDiffuseScale = 1 end) task.spawn(function() local clock = os.clock() for i, item in ipairs(workspace:GetDescendants()) do if not GlossyState.enabled[mode] then break end if item:IsA("BasePart") then createGlossyOverlay(item, mode) end if i % 1500 == 0 or os.clock() - clock > 0.015 then task.wait() clock = os.clock() end end end) if not GlossyState.conns[mode] then GlossyState.conns[mode] = workspace.DescendantAdded:Connect(function(d) if GlossyState.enabled[mode] and d:IsA("BasePart") then task.defer(createGlossyOverlay, d, mode) end end) end else for part, clone in pairs(GlossyState.overlays[mode]) do if clone and clone.Parent then pcall(function() clone:Destroy() end) end end table.clear(GlossyState.overlays[mode]) if GlossyState.conns[mode] then GlossyState.conns[mode]:Disconnect() GlossyState.conns[mode] = nil end end end
local function setGlossyIntensity(v) GlossyState.intensity = math.clamp(tonumber(v) or 0.25, 0, 1) for _, mode in ipairs({"Combo", "Metal", "Plastic"}) do for part, clone in pairs(GlossyState.overlays[mode]) do if clone and clone.Parent then pcall(function() clone.Transparency = GlossyState.intensity end) end end end end

pcall(function() SSRTab:Divider() end)
pcall(function() SSRTab:Section({ Title = "<font color='#ff0000'>Glossy Reflections</font>", TextSize = 16 }) end)
SSRTab:Toggle({ Title = "<font color='#ff0000'>Combo Glossy</font>", Value = false, Callback = function(v) setGlossyMode("Combo", v) end })
SSRTab:Toggle({ Title = "<font color='#ff0000'>Glossy Metal</font>", Value = false, Callback = function(v) setGlossyMode("Metal", v) end })
