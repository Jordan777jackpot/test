-- ==========================================
local AvatarAuto = {
    active = false,
    userId = nil,
    desc = nil,
    applied = setmetatable({}, { __mode = "k" }),
    lastCheck = 0,
    conns = {},
}

local function disconnectAvatarAuto()
    for i = 1, #AvatarAuto.conns do
        pcall(function() AvatarAuto.conns[i]:Disconnect() end)
    end
    AvatarAuto.conns = {}
end

local function autoApplyToAll()
    if not AvatarAuto.active or not AvatarAuto.desc then return end
    local models = findAllOwnModels()
    for _, m in ipairs(models) do
        if not AvatarAuto.applied[m] then
            if applyDesc(m, AvatarAuto.desc) then
                AvatarAuto.applied[m] = true
            end
            task.wait(0.05)
        end
    end
end

local function startAvatarAuto(userId, desc)
    disconnectAvatarAuto()
    AvatarAuto.active = true
    AvatarAuto.userId = userId
    AvatarAuto.desc = desc
    AvatarAuto.applied = setmetatable({}, { __mode = "k" })
    AvatarAuto.lastCheck = 0

    -- Respawn
    table.insert(AvatarAuto.conns, LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.6)
        if AvatarAuto.active then autoApplyToAll() end
    end))

    -- Rig baru di Workspace.Rigs
    local rigs = Workspace:FindFirstChild("Rigs")
    if rigs then
        table.insert(AvatarAuto.conns, rigs.ChildAdded:Connect(function(obj)
            if AvatarAuto.active and obj:IsA("Model") then
                task.wait(0.4)
                if AvatarAuto.active and not AvatarAuto.applied[obj] then
                    if applyDesc(obj, AvatarAuto.desc) then
                        AvatarAuto.applied[obj] = true
                    end
                end
            end
        end))
    end

    -- Model baru di Workspace
    table.insert(AvatarAuto.conns, Workspace.ChildAdded:Connect(function(obj)
        if AvatarAuto.active and obj:IsA("Model") then
            task.wait(0.4)
            if AvatarAuto.active and not AvatarAuto.applied[obj] then
                local models = findAllOwnModels()
                if table.find(models, obj) then
                    if applyDesc(obj, AvatarAuto.desc) then
                        AvatarAuto.applied[obj] = true
                    end
                end
            end
        end
    end))

    -- Heartbeat safety net (3 detik)
    table.insert(AvatarAuto.conns, RunService.Heartbeat:Connect(function()
        if not AvatarAuto.active then return end
        local now = tick()
        if now - AvatarAuto.lastCheck >= 3 then
            AvatarAuto.lastCheck = now
            autoApplyToAll()
        end
    end))
end

local function stopAvatarAuto()
    AvatarAuto.active = false
    AvatarAuto.userId = nil
    AvatarAuto.desc = nil
    AvatarAuto.applied = setmetatable({}, { __mode = "k" })
    disconnectAvatarAuto()
end

