local trackedModels = setmetatable({}, { __mode = "k" })
local lastReapply = {}

local function tryReapply(model)
    if not model or not model.Parent then return end
    local now = os.clock()
    if lastReapply[model] and (now - lastReapply[model]) < 0.5 then return end
    lastReapply[model] = now
    task.spawn(function()
        task.wait(0.2)
        if model and model.Parent then pcall(applyAllVisualsToModel, model) end
    end)
end

local function watchModel(model)
    if not model or trackedModels[model] then return end
    trackedModels[model] = true
    model.ChildRemoved:Connect(function(removed)
        if removed then
            local n = removed.Name
            if n == "Head" or n:find("Near") or removed:IsA("Accessory") then
                if localHeadless or localKorblox or localKorbloxLeft then
                    tryReapply(model)
                end
            end
        end
    end)
end

