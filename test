-- ==========================================
local Spoof = {
    active = false,
    targetUserId = nil,
    cachedImage = "",
    conn = nil,
    originals = {},
}

local function fetchFullAvatarThumbnail(userId)
    local content = ""
    pcall(function()
        local result, isReady = Players:GetUserThumbnailAsync(
            userId,
            Enum.ThumbnailType.AvatarThumbnail,
            Enum.ThumbnailSize.Size420x420
        )
        if isReady and result then content = result end
    end)
    return content
end

local function applySpoofThumbnail()
    if not Spoof.targetUserId or Spoof.cachedImage == "" then return end
    local myName = LocalPlayer.Name:lower()
    local myDisplay = LocalPlayer.DisplayName:lower()

    pcall(function()
        local guis = {}
        pcall(function()
            table.insert(guis, game:GetService("CoreGui"))
            if gethui then table.insert(guis, gethui()) end
        end)
        table.insert(guis, LocalPlayer.PlayerGui)

        for _, gui in ipairs(guis) do
            for _, cardContent in ipairs(gui:GetDescendants()) do
                if cardContent:IsA("GuiObject") and cardContent.Name == "CardContent" then
                    local isMine = false
                    local details = cardContent:FindFirstChild("CardDetails")
                    if details then
                        for _, desc in ipairs(details:GetDescendants()) do
                            if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                                local txt = (desc.Text or ""):lower()
                                if txt:find(myName, 1, true) or txt:find(myDisplay, 1, true) or txt:find("@" .. myName, 1, true) then
                                    isMine = true; break
                                end
                            end
                        end
                    end
                    if isMine then
                        local thumbFrame = cardContent:FindFirstChild("CardThumbnail", true)
                        if thumbFrame then
                            for _, child in ipairs(thumbFrame:GetDescendants()) do
                                if child ~= thumbFrame and child.Name ~= "LARP_SpoofImage" then
                                    if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                                        child.ImageTransparency = 1
                                        child.BackgroundTransparency = 1
                                    elseif child:IsA("ViewportFrame") or child:IsA("Model") or child:IsA("WorldModel") or child:IsA("Folder") then
                                        child.Visible = false
                                        pcall(function() child:ClearAllChildren() end)
                                    end
                                end
                            end
                            if thumbFrame:IsA("ImageLabel") or thumbFrame:IsA("ImageButton") then
                                thumbFrame.ImageTransparency = 1
                            end
                            local targetImg = thumbFrame:FindFirstChild("LARP_SpoofImage")
                            if not targetImg then
                                targetImg = Instance.new("ImageLabel")
                                targetImg.Name = "LARP_SpoofImage"
                                targetImg.Size = UDim2.new(1, 0, 1, 0)
                                targetImg.BackgroundTransparency = 1
                                targetImg.ScaleType = Enum.ScaleType.Fit
                                targetImg.ZIndex = 100
                                targetImg.Parent = thumbFrame
                            end
                            if targetImg then
                                if not Spoof.originals[thumbFrame] then
                                    Spoof.originals[thumbFrame] = true
                                end
                                targetImg.Image = Spoof.cachedImage
                                targetImg.ImageTransparency = 0
                                targetImg.Visible = true
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function startSpoof(userId)
    Spoof.targetUserId = userId
    Spoof.cachedImage = fetchFullAvatarThumbnail(userId)
    if Spoof.cachedImage == "" then return false end
    Spoof.active = true
    applySpoofThumbnail()
    if Spoof.conn then pcall(function() Spoof.conn:Disconnect() end) end
    local lastRun = 0
    Spoof.conn = RunService.Heartbeat:Connect(function(delta)
        lastRun = lastRun + delta
        if lastRun >= 0.3 then
            lastRun = 0
            if Spoof.active then applySpoofThumbnail() end
        end
    end)
    return true
end

local function stopSpoof()
    Spoof.active = false
    if Spoof.conn then
        pcall(function() Spoof.conn:Disconnect() end)
        Spoof.conn = nil
    end
    pcall(function()
        for thumbFrame in pairs(Spoof.originals) do
            if thumbFrame and thumbFrame.Parent then
                for _, child in ipairs(thumbFrame:GetDescendants()) do
                    if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                        child.ImageTransparency = 0
                    elseif child:IsA("ViewportFrame") then
                        child.Visible = true
                    end
                end
                if thumbFrame:IsA("ImageLabel") or thumbFrame:IsA("ImageButton") then
                    thumbFrame.ImageTransparency = 0
                end
                local targetImg = thumbFrame:FindFirstChild("LARP_SpoofImage")
                if targetImg then targetImg:Destroy() end
            end
        end
        Spoof.originals = {}
    end)
    Spoof.targetUserId = nil
    Spoof.cachedImage = ""
end
