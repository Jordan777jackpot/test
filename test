local tKucing, tMahkota, tKhodam, tBintang, tTanduk = false, false, false, false, false

-- Fungsi kumpulin semua username di server (kecuali diri sendiri)
local function getServerPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    table.sort(list)
    return list
end

-- Fungsi cari model target berdasarkan username (character + rigs)
local function getAllTargetsByName(name)
    local results = {}
    if not name or name == "" then return results end
    local clean = name:lower():gsub("%s+", "")

    local rigsFolder2 = Workspace:FindFirstChild("Rigs")
    if rigsFolder2 then
        for _, obj in ipairs(rigsFolder2:GetChildren()) do
            if obj:IsA("Model") then
                local on = obj.Name:lower():gsub("%s+", "")
                if on:sub(1, #clean) == clean then table.insert(results, obj) end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        local un = p.Name:lower():gsub("%s+", "")
        local dn = p.DisplayName and p.DisplayName:lower():gsub("%s+", "") or ""
        if un:sub(1, #clean) == clean or dn:sub(1, #clean) == clean then
            if p.Character and not table.find(results, p.Character) then
                table.insert(results, p.Character)
            end
        end
    end

    return results
end

