-- stripClothes AMAN: tidak hapus item hasil Visuals (prefix "Near")
local function stripClothes(rig)
    if not rig then return end
    local joints = rig:FindFirstChild("Joints")
    for _, d in ipairs(rig:GetDescendants()) do
        if (d:IsA("Accoutrement") or d:IsA("Clothing") or d:IsA("ShirtGraphic")) and not (joints and d:IsDescendantOf(joints)) then
            local n = d.Name or ""
            local isNearItem = (n:sub(1, 4) == "Near")
                or n == "NearHeadlessMesh"
                or n == "NearKorbloxMesh"
                or n == "NearKorbloxLeftMesh"
                or n == "NearWeld"
            if not isNearItem then
                pcall(function() d:Destroy() end)
            end
        end
    end
end

local function applyDesc(model, desc)
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    stripClothes(model)
    local ok = pcall(function() hum:ApplyDescriptionReset(desc) end)
    if not ok then
        ok = pcall(function() hum:ApplyDescription(desc) end)
    end
    if ok then
        pcall(function() applyAllVisualsToModel(model) end)
    end
    return ok
end
