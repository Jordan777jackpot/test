end

local function ensureEmoteClass()
    if EmoteClassRef then return EmoteClassRef end
    local ok, c = pcall(function() return require(ReplicatedStorage.Objects.Items.Emote) end)
    if ok and type(c) == "table" then EmoteClassRef = c end
    return EmoteClassRef
end

local function stopEmoteHook()
    hookActive = false
    lastEmoteName = nil
    local cls = EmoteClassRef
    if not cls then return end
    if emoteActivateW and cls.Activate == emoteActivateW and origAct then cls.Activate = origAct end
    if emoteDeactivateW and cls.Deactivate == emoteDeactivateW and origDeact then cls.Deactivate = origDeact end
    emoteActivateW, emoteDeactivateW, origAct, origDeact = nil, nil, nil, nil
end

local function startEmoteHook()
    local cls = ensureEmoteClass()
    if not cls or hookActive then return end
    if emoteActivateW and cls.Activate == emoteActivateW then return end
    origAct = cls.Activate
    origDeact = cls.Deactivate
    if type(origAct) ~= "function" then return end

    emoteActivateW = function(self, p2, p3)
        pcall(function()
            if type(origAct) == "function" then origAct(self, p2, p3) end
        end)
        pcall(function()
            local char = LocalPlayer.Character
            if not char or self.Character ~= char then return end
            if p2 == true then return end
            if tick() < emoteWarmupUntil then return end
            local anims = self.Animations
            local anim = anims and anims.Animation
            if not anim or not anim.IsPlaying or anim.Speed <= 0 then return end
            local mod = self.EmoteModule
            local nm = mod and mod.Name
            if not nm or nm == lastEmoteName then return end
            lastEmoteName = nm
            local rep = emoteReplacements[nm]
            if not rep or not rep.selectID then return end
            local ci = getEmoteInfo(nm)
            if ci and replacementTargetIds[ci.ID] then return end
            task.defer(function()
                if LocalPlayer.Character == char then setEmote(rep.selectID) end
            end)
        end)
    end

    emoteDeactivateW = function(self, ...)
        local pk = table.pack(...)
        pcall(function() if type(origDeact) == "function" then origDeact(self, table.unpack(pk, 1, pk.n)) end end)
        pcall(function() if self.Character == LocalPlayer.Character then lastEmoteName = nil end end)
    end

    cls.Activate = emoteActivateW
    cls.Deactivate = emoteDeactivateW
    hookActive = true
end

LocalPlayer.CharacterAdded:Connect(function()
    emoteWarmupUntil = tick() + 3
    lastEmoteName = nil
end)

