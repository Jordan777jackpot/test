-- Simpan warna asli kaki biar bisa di-restore (PATCH WARNA KAKI)
local korbloxOriginalColor = {}
local korbloxLeftOriginalColor = {}

local function applyHeadless(char, state)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    if state then
        head.Transparency = 1
        head.CanCollide = false
        local face = head:FindFirstChild("face") or head:FindFirstChild("Face")
        if face then face.Transparency = 1 end
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 1 end
        end
        if not head:FindFirstChild("NearHeadlessMesh") then
            local mesh = Instance.new("SpecialMesh")
            mesh.Name = "NearHeadlessMesh"
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://1095708"
            mesh.Scale = Vector3.new(0.001, 0.001, 0.001)
            mesh.Parent = head
        end
    else
        head.Transparency = 0
        head.CanCollide = true
        local face = head:FindFirstChild("face") or head:FindFirstChild("Face")
        if face then face.Transparency = 0 end
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 0 end
        end
        local mesh = head:FindFirstChild("NearHeadlessMesh")
        if mesh then mesh:Destroy() end
    end
end

local function applyKorblox(char, state)
    if not char then return end
    local leg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLeg")
    local ru = char:FindFirstChild("RightUpperLeg")
    if ru then
        if state then
            ru.Transparency = 0
            ru.CanCollide = false
            if ru:IsA("MeshPart") then
                ru.MeshId = "http://www.roblox.com/asset/?id=902942096"
                ru.TextureID = "http://roblox.com/asset/?id=902843398"
            end
        else
            ru.Transparency = 0
            ru.CanCollide = true
            if ru:IsA("MeshPart") then ru.MeshId = "" ru.TextureID = "" end
        end
    end
    if leg then
        if state then
            if not korbloxOriginalColor[leg] then
                korbloxOriginalColor[leg] = leg.Color
            end
            leg.Color = Color3.fromRGB(64, 64, 64)
            if not leg:FindFirstChild("NearKorbloxMesh") then
                local mesh = Instance.new("SpecialMesh")
                mesh.Name = "NearKorbloxMesh"
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = "rbxassetid://101851696"
                mesh.TextureId = "rbxassetid://101851254"
                mesh.Parent = leg
            end
        else
            if korbloxOriginalColor[leg] then
                leg.Color = korbloxOriginalColor[leg]
                korbloxOriginalColor[leg] = nil
            end
            local mesh = leg:FindFirstChild("NearKorbloxMesh")
            if mesh then mesh:Destroy() end
        end
    end
end

