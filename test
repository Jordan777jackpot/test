local function findModule(...)
    local node = ReplicatedStorage
    for _, name in ipairs({...}) do
        node = node and node:FindFirstChild(name)
    end
    return node
end

local RigService = nil
local function getRigService()
    if RigService == nil then
        local ok, svc = pcall(function()
            return require(findModule("Services", "Asset", "RigService"))
        end)
        RigService = (ok and type(svc) == "table") and svc or false
    end
    return RigService
end

-- [HYDRA] deteksi rig via RigService (khusus Rigs)
local function findRigByHydra()
    local char = LocalPlayer.Character
    local tag = char and char:GetAttribute("Tag")
    if tag == nil then return nil end
    local svc = getRigService()
    if not svc then return nil end
    local ok, data = pcall(function() return svc:GetRigFromTag(tag) end)
    local model = ok and type(data) == "table" and data.Model or nil
    if model and model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
        return model
    end
    return nil
end

local function findAllOwnModels()
    local models = {}
    local seen = {}
    local function add(m)
        if m and m:IsA("Model") and not seen[m] and m:FindFirstChildOfClass("Humanoid") then
            seen[m] = true
            table.insert(models, m)
        end
    end

    -- ===== NON-RIGS (LARP) =====
    -- 1. Character utama
    if LocalPlayer.Character then add(LocalPlayer.Character) end

    -- 2. Workspace langsung dengan nama player
    local wsModel = workspace:FindFirstChild(LocalPlayer.Name)
    if wsModel then add(wsModel) end

    -- 3. Folder umum lain
    local commonFolders = {"Characters", "PlayerModels", "Players", "Entities"}
    for _, folderName in ipairs(commonFolders) do
        local folder = workspace:FindFirstChild(folderName)
        if folder and folder:IsA("Folder") then
            local model = folder:FindFirstChild(LocalPlayer.Name)
            if model then add(model) end
        end
    end

    -- ===== RIGS (HYDRA) =====
    -- 4. Rigs via RigService:GetRigFromTag (Hydra)
    local hydraRig = findRigByHydra()
    if hydraRig then add(hydraRig) end

    -- 5. Fallback: Rigs folder langsung (LARP) — kalau RigService gagal
    if not hydraRig then
        local rigs = workspace:FindFirstChild("Rigs")
        if rigs then
            add(rigs:FindFirstChild(LocalPlayer.Name))
            local lowerName = LocalPlayer.Name:lower()
            for _, obj in ipairs(rigs:GetChildren()) do
                if obj:IsA("Model") then
                    local n = obj.Name:lower()
                    if n == lowerName or n:sub(1, #lowerName) == lowerName then add(obj) end
                end
            end
        end
    end

    return models
end

